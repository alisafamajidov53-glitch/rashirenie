{
  // Checking config: covers src *and* test, so `npm run typecheck` and ESLint's
  // type-aware rules see the test suite. Emitting is done by tsconfig.build.json,
  // which keeps rootDir at src so tests never land in dist.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src", "test"]
}
