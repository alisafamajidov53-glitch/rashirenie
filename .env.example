# Backend
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Optional backend token audience. The extension itself accepts OAuth Client ID
# in its settings screen and does not read this value.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional server-side AI providers. For normal extension use, keys can instead
# be entered directly in the extension interface.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TWELVELABS_API_KEY=
TWELVELABS_MODEL=pegasus1.5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Comma-separated extension IDs allowed in production.
ALLOWED_EXTENSION_IDS=gocaamcdkphkcdmadccihalpdgabdlfa

# Local-only switch. Never enable this on a public deployment.
DEV_BYPASS_AUTH=false
